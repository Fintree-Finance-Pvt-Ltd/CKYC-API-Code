generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CkycClient {
  id         BigInt @id @default(autoincrement())
  clientCode String @unique @map("client_code")
  clientName String @map("client_name")

  apiKeyHash String @map("api_key_hash")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  requests CkycRequest[]

  @@map("ckyc_clients")
}

model CkycRequest {
  id BigInt @id @default(autoincrement())

  requestUuid String @unique @map("request_uuid")

  clientId BigInt @map("client_id")

  operation CkycOperation

  provider CkycProvider @default(BEFISC)

  identifierType String? @map("identifier_type")

  identifierMasked String? @map("identifier_masked")

  providerTxnId String? @map("provider_txn_id")

  providerRequestId String? @map("provider_request_id")

  status CkycRequestStatus @default(INITIATED)

  providerStatus Int? @map("provider_status")

  billable Boolean?

  errorCode String? @map("error_code")

  errorMessage String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  client CkycClient @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([requestUuid])
  @@index([providerTxnId])
  @@index([providerRequestId])
  @@index([createdAt])
  @@map("ckyc_requests")
}

model CkycOtpSession {
  id BigInt @id @default(autoincrement())

  requestUuid String @unique @map("request_uuid")

  providerRequestId String @map("provider_request_id")

  ckycMasked String? @map("ckyc_masked")

  authFactorMasked String? @map("auth_factor_masked")

  status String

  expiresAt DateTime? @map("expires_at")

  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([providerRequestId])
  @@map("ckyc_otp_sessions")
}

model CkycAuditLog {
  id BigInt @id @default(autoincrement())

  requestUuid String @map("request_uuid")

  clientCode String @map("client_code")

  action String

  provider String?

  status String

  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([requestUuid])
  @@index([createdAt])
  @@map("ckyc_audit_logs")
}

enum CkycOperation {
  SEARCH
  DOWNLOAD_SEND_OTP
  DOWNLOAD_VERIFY_OTP
  DOWNLOAD_RESEND_OTP
  UPLOAD
  UPDATE
}

enum CkycProvider {
  BEFISC
  NETWIN
}

enum CkycRequestStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
}
